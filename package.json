{
  "name": "gas-portfolio-tracker",
  "productName": "Gas Portfolio Tracker",
  "version": "2.2.1",
  "description": "Track gas portfolio hours and unassisted write-ups toward the deadline.",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "test": "node test/logic.test.js"
  },
  "author": "Connor W",
  "license": "MIT",
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "local.gaslog.tracker",
    "productName": "Gas Portfolio Tracker",
    "copyright": "Made by Connor W",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": null
    },
    "dmg": {
      "title": "Gas Portfolio Tracker"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}